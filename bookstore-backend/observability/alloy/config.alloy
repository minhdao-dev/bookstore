local.file_match "bookstore_backend_logs" {
	path_targets = [
		{
			__path__ = "/var/log/bookstore/app.log",
			job      = "bookstore-backend",
		},
	]
}

loki.source.file "bookstore_backend" {
	targets       = local.file_match.bookstore_backend_logs.targets
	forward_to    = [loki.write.local_loki.receiver]
	tail_from_end = true
}

loki.write "local_loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
